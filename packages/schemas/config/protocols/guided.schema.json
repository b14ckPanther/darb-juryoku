{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/protocols/guided.schema.json",
  "title": "Dataset Studio guided protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps", "passive", "lighting", "chairs", "cameras"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "seconds"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "enum": ["upright", "slouch", "forward_head", "lean_side"]
          },
          "side": {
            "enum": ["left", "right"]
          },
          "seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "passive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompts_per_hour"],
      "properties": {
        "prompts_per_hour": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "default"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "default": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "lighting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "chairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    }
  }
}
