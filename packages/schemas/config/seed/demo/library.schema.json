{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/seed/demo/library.schema.json",
  "title": "Demo only: calibrations, models and recordings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibrations",
    "cameras",
    "classes",
    "gates",
    "heuristic",
    "models",
    "recordings",
    "playback",
    "studio_speed",
    "studio_kb_per_second"
  ],
  "properties": {
    "calibrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "camera",
          "created",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "camera": {
            "type": "string",
            "minLength": 1
          },
          "created": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "upright",
          "slouch",
          "forward_head",
          "lean_side"
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro_f1",
        "slouch_recall",
        "beats_heuristic",
        "wasm_p95_ms"
      ],
      "properties": {
        "macro_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slouch_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beats_heuristic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wasm_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "heuristic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confusion"
      ],
      "properties": {
        "confusion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "data_version",
          "released",
          "size_kb",
          "active",
          "confusion",
          "latency_ms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "data_version": {
            "type": "string",
            "minLength": 1
          },
          "released": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "size_kb": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          },
          "confusion": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "latency_ms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runs",
              "webgpu",
              "wasm"
            ],
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 1
              },
              "webgpu": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "p50",
                  "p95",
                  "p99"
                ],
                "properties": {
                  "p50": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "wasm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "p50",
                  "p95",
                  "p99"
                ],
                "properties": {
                  "p50": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "recordings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "protocol",
          "seconds",
          "size_kb",
          "lighting",
          "chair",
          "camera"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "protocol": {
            "enum": [
              "guided",
              "passive"
            ]
          },
          "seconds": {
            "type": "integer",
            "minimum": 1
          },
          "size_kb": {
            "type": "integer",
            "minimum": 1
          },
          "lighting": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "chair": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "camera": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds_per_key",
        "match",
        "state_from",
        "drift_class",
        "nudge_after_seconds",
        "quiet_after_nudge_seconds",
        "match_when_still",
        "match_example_drift",
        "match_framing",
        "tick_ms",
        "bench_ms"
      ],
      "properties": {
        "seconds_per_key": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "match": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "state_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upright"
          ],
          "properties": {
            "upright": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "drift_class": {
          "enum": [
            "slouch",
            "forward_head",
            "lean_side"
          ]
        },
        "nudge_after_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "quiet_after_nudge_seconds": {
          "type": "number",
          "minimum": 0
        },
        "match_when_still": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "match_example_drift": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "match_framing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tick_ms": {
          "type": "integer",
          "minimum": 16
        },
        "bench_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "studio_speed": {
      "type": "number",
      "minimum": 1
    },
    "studio_kb_per_second": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
