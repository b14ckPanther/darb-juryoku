{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/pose.schema.json",
  "title": "Pose detection files and options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wasm_base",
    "model_path",
    "model_source",
    "model_sha256",
    "delegates",
    "num_poses",
    "min_pose_detection_confidence",
    "min_pose_presence_confidence",
    "min_tracking_confidence",
    "outline",
    "backdrop"
  ],
  "properties": {
    "wasm_base": {
      "type": "string",
      "pattern": "^/"
    },
    "model_path": {
      "type": "string",
      "pattern": "^/.*\\.task$"
    },
    "model_source": {
      "type": "string",
      "pattern": "^https://"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delegates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GPU",
          "CPU"
        ]
      }
    },
    "num_poses": {
      "const": 1
    },
    "min_pose_detection_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min_pose_presence_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min_tracking_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neck_at",
        "neck_inset",
        "temple_up",
        "temple_inset",
        "crown_up",
        "arm_spread"
      ],
      "properties": {
        "neck_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "neck_inset": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "temple_up": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "temple_inset": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "crown_up": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "arm_spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "backdrop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brightness",
        "saturate"
      ],
      "properties": {
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "saturate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
