{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/heuristic.schema.json",
  "title": "Heuristic baseline thresholds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "temperature",
    "classes"
  ],
  "properties": {
    "temperature": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_head",
        "slouch",
        "lean_side"
      ],
      "properties": {
        "forward_head": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "op",
              "threshold",
              "scale"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "op": {
                "enum": [
                  "lt",
                  "gt",
                  "abs_gt"
                ]
              },
              "threshold": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "slouch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "op",
              "threshold",
              "scale"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "op": {
                "enum": [
                  "lt",
                  "gt",
                  "abs_gt"
                ]
              },
              "threshold": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "lean_side": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "op",
              "threshold",
              "scale"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "op": {
                "enum": [
                  "lt",
                  "gt",
                  "abs_gt"
                ]
              },
              "threshold": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
