{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/settings.schema.json",
  "title": "Defaults and choices for user settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sensitivity",
    "sample_rates_hz",
    "retention_days_options",
    "calibration_hold_seconds",
    "budokai_enabled_default",
    "shortcuts",
    "sentinel_window",
    "toast_seconds"
  ],
  "properties": {
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "default"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "default": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sample_rates_hz": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "retention_days_options": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "calibration_hold_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "budokai_enabled_default": {
      "type": "boolean"
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pause",
        "calibrate",
        "sentinel",
        "help"
      ],
      "properties": {
        "pause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "calibrate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "sentinel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        }
      }
    },
    "sentinel_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 120
        },
        "height": {
          "type": "integer",
          "minimum": 90
        }
      }
    },
    "toast_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
