{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/pose.schema.json",
  "title": "Pose detection files and options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wasm_base",
    "model_path",
    "model_source",
    "model_sha256",
    "delegates",
    "num_poses",
    "min_pose_detection_confidence",
    "min_pose_presence_confidence",
    "min_tracking_confidence"
  ],
  "properties": {
    "wasm_base": {
      "type": "string",
      "pattern": "^/"
    },
    "model_path": {
      "type": "string",
      "pattern": "^/.*\\.task$"
    },
    "model_source": {
      "type": "string",
      "pattern": "^https://"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delegates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GPU",
          "CPU"
        ]
      }
    },
    "num_poses": {
      "const": 1
    },
    "min_pose_detection_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min_pose_presence_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min_tracking_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
