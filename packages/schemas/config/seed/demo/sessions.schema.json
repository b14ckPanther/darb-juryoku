{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darb-juryoku.local/schemas/config/seed/demo/sessions.schema.json",
  "title": "Demo only: generated sessions with one letter per minute",
  "type": "object",
  "additionalProperties": false,
  "required": ["codes", "sessions"],
  "properties": {
    "codes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]$" },
      "additionalProperties": {
        "enum": ["upright", "slouch", "forward_head", "lean_side", "absent", "unknown"]
      },
      "minProperties": 6
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "start", "model", "device", "minutes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "model": { "type": "string", "minLength": 1 },
          "device": { "type": "string", "minLength": 1 },
          "minutes": { "type": "string", "pattern": "^[a-z]+$" }
        }
      }
    }
  }
}
